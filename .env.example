# 프론트(Expo)가 쓰는 값. 실제 값은 `npm run status` 또는 Supabase 대시보드에서 확인.
# 프론트 저장소의 .env 에 넣는다. publishable 키는 앱에 들어가도 되는 공개 키.
# secret(service_role) 키는 절대 앱이나 이 파일에 넣지 않는다.

# 로컬: http://127.0.0.1:54321  / 클라우드: https://<프로젝트 ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 프론트 코드가 이미 쓰는 API 주소. Edge Function 주소로 맞춘다.
# 예: http://127.0.0.1:54321/functions/v1  → 요청 경로 /bongging/certifications 가 그대로 동작
EXPO_PUBLIC_API_URL=
